{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "govp-io",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "routes": [
    { "pattern": "govp.io", "custom_domain": true },
    { "pattern": "www.govp.io", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "govp-releases" }
  ]
}
